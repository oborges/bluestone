[Unit]
Description=Bluestone
Documentation=https://github.com/oborges/bluestone
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bluestone
Group=bluestone
Environment=BLUESTONE_CONFIG=/etc/bluestone/config.yaml
EnvironmentFile=-/etc/default/bluestone
ExecStart=/usr/local/bin/bluestone --config ${BLUESTONE_CONFIG}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
LimitNOFILE=1048576
UMask=0027

# Allow the unprivileged service user to bind the default NFS port, TCP/2049.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Keep the service tightly scoped while preserving writable cache/staging state.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/cache/bluestone /var/staging/bluestone /var/log/bluestone
CacheDirectory=bluestone
LogsDirectory=bluestone
RuntimeDirectory=bluestone
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
