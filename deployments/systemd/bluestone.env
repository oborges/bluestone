# Optional environment overrides for nfs-gateway.service.
# The installer copies this file to /etc/default/nfs-gateway.
#
# Keep secret values protected; the installer uses mode 0640 and group
# nfs-gateway so only root and the service can read this file.

NFS_GATEWAY_CONFIG=/etc/nfs-gateway/config.yaml

# Examples:
# NFS_GATEWAY_COS_API_KEY=replace-with-ibm-cloud-api-key
# NFS_GATEWAY_COS_ACCESS_KEY=replace-with-hmac-access-key
# NFS_GATEWAY_COS_SECRET_KEY=replace-with-hmac-secret-key
# NFS_GATEWAY_LOGGING_LEVEL=info
