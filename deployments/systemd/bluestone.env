# Optional environment overrides for bluestone.service.
# The installer copies this file to /etc/default/bluestone.
#
# Keep secret values protected; the installer uses mode 0640 and group
# bluestone so only root and the service can read this file.

BLUESTONE_CONFIG=/etc/bluestone/config.yaml

# Examples:
# BLUESTONE_COS_API_KEY=replace-with-ibm-cloud-api-key
# BLUESTONE_COS_ACCESS_KEY=replace-with-hmac-access-key
# BLUESTONE_COS_SECRET_KEY=replace-with-hmac-secret-key
# BLUESTONE_LOGGING_LEVEL=info
